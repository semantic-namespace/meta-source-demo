;; What meta-source reads, and with which packs: the system (integrant), the
;; routes (reitit), the data shapes (malli), the order's life (tilakone), and
;; what the team says about all of it (atlas, in registry/). Nothing is run.
;;
;;   bb meta-source check --brief
{:src ["src"]
 :registry ["registry"]
 :rules ["rules"]
 :packs {:integrant {:configs ["resources"] :pattern true}
         :reitit {:pattern true}
         :malli {:registries [shop.schema/registry]}
         :tilakone {}
         atlas.meta-source/pack {}}
 :deps {io.github.semantic-namespace/meta-source-packs
        {:git/url "https://github.com/semantic-namespace/meta-source-packs"
         :git/sha "43db9ec365c0692d7edc3094e7412738972d1adf"}
        io.github.semantic-namespace/atlas
        {:git/url "https://github.com/semantic-namespace/atlas"
         :git/sha "553be419162f5003efc96e010130eb8ec155f5bc" :deps/root "core"}}}
